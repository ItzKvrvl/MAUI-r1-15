<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r10.MainPage"
              x:Name="Page">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider 
                x:Name="suwak"  
                Minimum="0" 
                Maximum="255" 
                Value="0"/>

            <Label Text="{Binding Source={x:Reference suwak}, Path=Value, StringFormat='Poziom: {0:F0}'}"/>
            
            <Button
                Text="Zastosuj jako szarość"
                Clicked="Button_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
