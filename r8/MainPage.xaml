<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r8.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry x:Name="Szerokosc" Placeholder="Szerokosc"/>
            <Entry x:Name="Wysokosc" Placeholder="Wysokosc"/>

            <Button x:Name="Count" Text="Oblicz" Clicked="Count_Clicked"/>
            <Button x:Name="Clear" Text="Wyczysc" Clicked="Clear_Clicked"/>

            <Label x:Name="RectangleArea"
                Text="Pole prostokata: 0"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
