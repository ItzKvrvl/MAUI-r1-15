<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PowitanieApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="PowitanieApp"
                SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="Label2" Text="Witamy w aplikacji" />

            <Button
                x:Name="Btn"
                Text="Zmień powitanie"
                Clicked="OnClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="BtnReset"
                Text="Resetuj"
                Clicked="OnResetClicked"
                HorizontalOptions="Fill" />

            <Label x:Name="LabelCounter" Text="Liczba klikniec : 0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
