<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r9.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry x:Name="NowyProdukt" Placeholder="Dodaj nowy produkt"/>
            <Button Text="Dodaj" Clicked="Button_Clicked"/>
            <Button Text="Usun zaznaczone" Clicked="DeleteClicked"/>
            <CollectionView x:Name="WidokListy" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}"
                               FontSize="18"
                               Padding="10"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="LiczbaZakupow" Text="Aktualna Liczba Zakupow: 0"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
